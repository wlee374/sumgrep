[qdrant]
url = "http://localhost:6333"
collection = "sumgrep"

[embed]
provider = "ollama"          # http://localhost:11434
model = "bge-m3"
dims = 1024                  # married to the collection; assert on startup

[search]
mode = "summary"      # summary | code | hybrid — what the question is compared against
                      # 2026-09-07 mini-eval (15 conceptual q): summary hit@5 0.93,
                      # hybrid 0.67, code 0.53. Override per call with --mode.
k = 10                # pointers returned (5 -> 10 on 2026-10-12: 4 of 5 reused helpers ranked 6-15)
floor = 0.35          # drop hits whose best cosine is below this
code_weight = 1.0     # hybrid only: scale of the code arm (summary arm = 1.0)

[server]              # only for one shared team server: uv run sumgrep serve (SETUP.md §7b)
address = "0.0.0.0:8000"   # HOST:PORT to listen on; 0.0.0.0 = every network this machine is on
https = false              # true: serve https with the two files below
tls_cert = ""              # e.g. "/etc/ssl/sumgrep/fullchain.pem" (the full chain, if you have one)
tls_key = ""               # e.g. "/etc/ssl/sumgrep/key.pem" (no password)
search_log = "~/.sumgrep/searches.jsonl"   # every search, one JSON line; at 10 MB it rotates,
                                           # 5 files kept (50 MB at most); "" = off

[rerank]                  # an LLM reorders the top hits at search time; off by default
enabled = false           # true: search = retrieval (0.2 s) + one LLM call (~2 s with Haiku)
provider = "anthropic"    # ollama | anthropic | bedrock — independent of [summarize]
model = "claude-haiku-5-5"
think = "low"             # reasoning effort; low is what the evals measured
candidates = 20           # retrieval hits it reads (max 20)
text = "summary"          # "summary" = the stored summary; "first" = first sentence only (small local models)
timeout = 10              # seconds; past this, or on any error, the retrieval order is returned
max_retries = 0
#num_ctx = 16384          # ollama: 20 summaries are ~14k tokens; the default context truncates them

[summarize]
# Default: a local model that runs on any OS with ~8 GB of free RAM. No API
# key, and your code never leaves the machine. First: ollama pull qwen3.5:9b
provider = "ollama"
model = "qwen3.5:9b"      # 6.6 GB. Less RAM: "qwen3.5:4b" (3.3 GB).
                          # 20+ GB free: "qwen3.8:27b" (or "qwen3.8:27b-mlx" on
                          # Apple Silicon), the model behind the README's results
max_words = 300
num_ctx = 12000       # ollama: room for instructions + an 8k-char chunk + output
think = false         # ollama: skip the reasoning pass
temperature = 0.7     # ollama only
top_p = 0.8           # ollama only
keep_alive = "10m"    # ollama: keep the model loaded between calls
max_tokens = 1500
presence_penalty = 1.5   # ollama: Qwen's own setting against repetition loops

# Faster, needs an API key (export ANTHROPIC_API_KEY=sk-ant-api...; never
# Claude Code's login token). Replace `provider`, `model` and `max_tokens`
# above with these. Haiku 5.5 thinks before it writes, and thinking counts
# toward max_tokens, so leave it room. The ollama-only keys are ignored.
#provider = "anthropic"
#model = "claude-haiku-5-5"
#max_tokens = 4000
#
# Or through Amazon Bedrock (AWS credentials from the usual AWS chain):
#provider = "bedrock"
#model = "us.anthropic.claude-haiku-4-5-20251001-v1:0"
#aws_region = "us-west-2"
#max_words = 120


# One block per repo you index, matched to --repo by `path`; `name` is a label.
[[repos]]
name = "myrepo"
path = "/path/to/myrepo"
exclude = ["third_party/*"]   # glob patterns skipped when chunking (vendored code etc.)

